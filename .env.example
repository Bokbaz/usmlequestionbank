NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables ARGO question writing and AI-assisted import (classify, repair)
ANTHROPIC_API_KEY=
# Optional: ARGO-written question drafts per add-on subscriber per 30 days (default 15)
ARGO_WRITE_MONTHLY_LIMIT=15
# Billing: use a restricted server API key in production. Never expose it to the browser.
STRIPE_RESTRICTED_KEY=
# Backward-compatible alternative to STRIPE_RESTRICTED_KEY
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Required: signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Optional overrides; otherwise resolve the stable lookup keys in src/lib/plans.ts
STRIPE_ACCESS_PRICE_ID=
STRIPE_WRITER_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional: search console ownership meta tags (or verify the domain by DNS instead)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
